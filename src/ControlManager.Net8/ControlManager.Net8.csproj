<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWpf>true</UseWpf>
    <OutputType>Library</OutputType>
    <Platforms>x64</Platforms>
    <Configurations>Debug2025;Release2025;Debug2026;Release2026</Configurations>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ControlManager</AssemblyName>
    <RootNamespace>ControlManager</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <ProjectGuid>{A1C8E2F4-5B67-4D89-9E01-2A3B4C5D6E7F}</ProjectGuid>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug2025|x64'">
    <DefineConstants>DEBUG;TRACE;REVIT2025</DefineConstants>
    <OutputPath>bin\x64\Debug2025\</OutputPath>
    <RevitAddinsPath>C:\ProgramData\Autodesk\Revit\Addins\2025\</RevitAddinsPath>
    <RevitYear>2025</RevitYear>
    <Nice3pointApiVersion>2025.4.50</Nice3pointApiVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release2025|x64'">
    <DefineConstants>TRACE;REVIT2025</DefineConstants>
    <OutputPath>bin\Release2025\</OutputPath>
    <RevitAddinsPath>C:\ProgramData\Autodesk\Revit\Addins\2025\</RevitAddinsPath>
    <RevitYear>2025</RevitYear>
    <Nice3pointApiVersion>2025.4.50</Nice3pointApiVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug2026|x64'">
    <DefineConstants>DEBUG;TRACE;REVIT2026</DefineConstants>
    <OutputPath>bin\x64\Debug2026\</OutputPath>
    <RevitAddinsPath>C:\ProgramData\Autodesk\Revit\Addins\2026\</RevitAddinsPath>
    <RevitYear>2026</RevitYear>
    <Nice3pointApiVersion>2026.4.10</Nice3pointApiVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release2026|x64'">
    <DefineConstants>TRACE;REVIT2026</DefineConstants>
    <OutputPath>bin\Release2026\</OutputPath>
    <RevitAddinsPath>C:\ProgramData\Autodesk\Revit\Addins\2026\</RevitAddinsPath>
    <RevitYear>2026</RevitYear>
    <Nice3pointApiVersion>2026.4.10</Nice3pointApiVersion>
  </PropertyGroup>

  <!-- API local si Revit del año está instalado -->
  <ItemGroup Condition="'$(RevitYear)' != '' AND Exists('C:\Program Files\Autodesk\Revit $(RevitYear)\RevitAPI.dll')">
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitYear)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitYear)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Fallback Nice3point: versiones fijas por configuración (restore/build -c ReleaseXXXX) -->
  <ItemGroup Condition="('$(Configuration)' == 'Debug2025' OR '$(Configuration)' == 'Release2025') AND !Exists('C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll')">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.4.50">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.4.50">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup Condition="('$(Configuration)' == 'Debug2026' OR '$(Configuration)' == 'Release2026') AND !Exists('C:\Program Files\Autodesk\Revit 2026\RevitAPI.dll')">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2026.4.10">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2026.4.10">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="DocumentFormat.OpenXml.Framework" Version="3.1.1" />
    <!-- Pin explícito + copia al output (App Store escanea DLLs del paquete) -->
    <PackageReference Include="System.IO.Packaging" Version="10.0.10">
      <PrivateAssets>none</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ControlManager.Shared\Models\ElementIssue.cs" Link="Models\ElementIssue.cs" />
    <Compile Include="..\ControlManager.Shared\Models\Enums.cs" Link="Models\Enums.cs" />
    <Compile Include="..\ControlManager.Shared\Models\SeverityFilterOption.cs" Link="Models\SeverityFilterOption.cs" />
    <Compile Include="..\ControlManager.Legacy\App.cs" Link="App.cs" />
    <Compile Include="..\ControlManager.Legacy\Commands\MainCommand.cs" Link="Commands\MainCommand.cs" />
    <Compile Include="..\ControlManager.Legacy\Commands\MainWindowSession.cs" Link="Commands\MainWindowSession.cs" />
    <Compile Include="..\ControlManager.Legacy\Services\ExportService.cs" Link="Services\ExportService.cs" />
    <Compile Include="..\ControlManager.Legacy\Services\FirstRunService.cs" Link="Services\FirstRunService.cs" />
    <Compile Include="..\ControlManager.Legacy\Services\QCService.cs" Link="Services\QCService.cs" />
    <Compile Include="..\ControlManager.Legacy\Utils\BoolToVisibilityConverter.cs" Link="Utils\BoolToVisibilityConverter.cs" />
    <Compile Include="..\ControlManager.Legacy\Utils\PrivacyPolicyHtmlPath.cs" Link="Utils\PrivacyPolicyHtmlPath.cs" />
    <Compile Include="..\ControlManager.Legacy\Utils\RelayCommand.cs" Link="Utils\RelayCommand.cs" />
    <Compile Include="..\ControlManager.Legacy\Utils\IconGenerator.cs" Link="Utils\IconGenerator.cs" />
    <Compile Include="..\ControlManager.Legacy\Utils\RevitHelper.cs" Link="Utils\RevitHelper.cs" />
    <Compile Include="..\ControlManager.Legacy\Utils\SeverityToColorConverter.cs" Link="Utils\SeverityToColorConverter.cs" />
    <Compile Include="..\ControlManager.Legacy\ViewModels\MainViewModel.cs" Link="ViewModels\MainViewModel.cs" />
    <Compile Include="..\ControlManager.Legacy\UI\MainWindow.xaml.cs" Link="UI\MainWindow.xaml.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>
    <Compile Include="..\ControlManager.Legacy\UI\PrivacyPolicyWindow.xaml.cs" Link="UI\PrivacyPolicyWindow.xaml.cs">
      <DependentUpon>PrivacyPolicyWindow.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\ControlManager.Legacy\Resources\Icons\icon_16.png" Link="Resources\Icons\icon_16.png" />
    <Resource Include="..\ControlManager.Legacy\Resources\Icons\icon_32.png" Link="Resources\Icons\icon_32.png" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="..\ControlManager.Legacy\Resources\Styles\AppStyles.xaml" Link="Resources\Styles\AppStyles.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="..\ControlManager.Legacy\UI\MainWindow.xaml" Link="UI\MainWindow.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="..\ControlManager.Legacy\UI\PrivacyPolicyWindow.xaml" Link="UI\PrivacyPolicyWindow.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\ControlManager.Legacy\ControlManager.addin" Link="ControlManager.addin" />
    <None Include="..\..\docs\privacy-policy.html" Link="docs\privacy-policy.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="DeployAddinToRevitAddinsFolder" AfterTargets="Build" Condition="'$(RevitAddinsPath)' != '' AND '$(DeployRevitAddinToFolder)' != 'false'">
    <MakeDir Directories="$(RevitAddinsPath)" />
    <MakeDir Directories="$(RevitAddinsPath)docs" />
    <Exec Command="cmd /c copy /Y &quot;$(TargetDir)*.dll&quot; &quot;$(RevitAddinsPath)&quot;" IgnoreExitCode="true" />
    <Exec Command="cmd /c copy /Y &quot;$(TargetDir)docs\privacy-policy.html&quot; &quot;$(RevitAddinsPath)docs\privacy-policy.html&quot;" IgnoreExitCode="true" Condition="Exists('$(TargetDir)docs\privacy-policy.html')" />
    <Exec Command="cmd /c copy /Y &quot;$(MSBuildProjectDirectory)\..\ControlManager.Legacy\ControlManager.addin&quot; &quot;$(RevitAddinsPath)ControlManager.addin&quot;" IgnoreExitCode="true" Condition="Exists('$(MSBuildProjectDirectory)\..\ControlManager.Legacy\ControlManager.addin')" />
    <Message Importance="high" Text="Control Manager: copia a $(RevitAddinsPath) intentada ($(Configuration)). Si Revit estaba abierto, ciérralo y vuelve a compilar." />
  </Target>
</Project>
